{{- /* JSON Feed 1.1 (https://jsonfeed.org/version/1.1) of the newest posts.
     Hugo makes relative URLs absolute in RSS but not here, so content's
     root-relative src, href, poster and srcset URLs are fixed up by hand. */ -}}
{{- $base := strings.TrimSuffix "/" site.BaseURL }}
{{- $pages := where site.RegularPages "Section" "in" site.Params.mainSections }}
{{- $items := slice }}
{{- range first (site.Config.Services.RSS.Limit | default 20) $pages }}
	{{- $html := .Content | replaceRE `((?:src|href|poster|srcset)=")/([^/])` (printf "${1}%s/${2}" $base) }}
	{{- $html = $html | replaceRE `(\d+w), /([^/])` (printf "${1}, %s/${2}" $base) }}
	{{- $item := dict
		"id" .Permalink
		"url" .Permalink
		"content_html" $html
		"date_published" (.Date.Format "2006-01-02T15:04:05-07:00")
		"date_modified" (.Lastmod.Format "2006-01-02T15:04:05-07:00")
	}}
	{{- with .Title }}{{ $item = merge $item (dict "title" .) }}{{ end }}
	{{- with .Params.categories }}{{ $item = merge $item (dict "tags" .) }}{{ end }}
	{{- $items = $items | append $item }}
{{- end }}
{{- $author := dict "name" site.Params.author.name "url" site.Home.Permalink }}
{{- with site.Params.author.avatar }}{{ $author = merge $author (dict "avatar" (absURL .)) }}{{ end }}
{{- $feed := dict
	"version" "https://jsonfeed.org/version/1.1"
	"title" site.Title
	"home_page_url" site.Home.Permalink
	"feed_url" (.OutputFormats.Get "jsonfeed").Permalink
	"description" site.Params.description
	"language" site.Language.Locale
	"authors" (slice $author)
	"items" $items
}}
{{- with site.Params.author.avatar }}{{ $feed = merge $feed (dict "icon" (absURL .)) }}{{ end }}
{{- $feed | jsonify (dict "indent" "  ") }}
