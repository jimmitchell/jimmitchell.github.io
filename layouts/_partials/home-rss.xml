{{- /* The home page's RSS feed, served at /index.xml and /feed.xml. Unlike
     Hugo's built-in feed it lists only posts and carries their full content,
     as Micro.blog's did, with root-relative URLs made absolute. */ -}}
{{- $base := strings.TrimSuffix "/" site.BaseURL }}
{{- $pages := where site.RegularPages "Section" "in" site.Params.mainSections }}
{{- $pages = first (site.Config.Services.RSS.Limit | default 20) $pages }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ site.Title }}</title>
		<link>{{ site.Home.Permalink }}</link>
		<description>{{ site.Params.description }}</description>
		<generator>Hugo</generator>
		<language>{{ site.Language.Locale }}</language>
		{{- with $pages }}
		<lastBuildDate>{{ (index .ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
		{{- end }}
		{{- with site.Home.OutputFormats.Get "rss" }}
		{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
		{{- $html := .Content | replaceRE `((?:src|href|poster|srcset)=")/([^/])` (printf "${1}%s/${2}" $base) }}
		{{- $html = $html | replaceRE `(\d+w), /([^/])` (printf "${1}, %s/${2}" $base) }}
		<item>
			<title>{{ .Title }}</title>
			<link>{{ .Permalink }}</link>
			<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
			<guid>{{ .Permalink }}</guid>
			<description>{{ $html | transform.XMLEscape | safeHTML }}</description>
		</item>
		{{- end }}
	</channel>
</rss>
